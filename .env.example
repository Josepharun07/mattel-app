# Local Docker Postgres: docker compose up -d
# For cloud beta testing, replace this with the hosted database URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mattel_infrastructures

# Super admin written into Postgres when the app or the seed starts.
ADMIN_USERNAME=admin@mattelinfra.com
ADMIN_PASSWORD=admin

# Vendor-agnostic S3 settings. Use a Cloudflare R2 or Supabase Storage endpoint.
S3_REGION=auto
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
S3_BUCKET=mattel-infrastructures
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
