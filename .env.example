# Local Docker Postgres. docker compose reads POSTGRES_* from this file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mattel_infrastructures
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mattel_infrastructures

# Super admin written into Postgres when the app or the seed starts.
ADMIN_USERNAME=admin@mattelinfra.com
ADMIN_PASSWORD=admin

# S3-compatible storage. Use a Cloudflare R2 or Supabase Storage endpoint.
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=mattel-infrastructures
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
S3_PRESIGN_SECONDS=900

# Outbound mail for the Inform employee checkbox on new staff.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
