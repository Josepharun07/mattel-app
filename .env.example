# Names only. Put real values in .env.local, never in this file.
POSTGRES_USER=db_user_q4n8
POSTGRES_PASSWORD=example-db-password-7h2k9p
DATABASE_URL=postgresql://db_user_q4n8:example-db-password-7h2k9p@localhost:5432/example
DATABASE_URL_UNPOOLED=postgresql://db_user_q4n8:example-db-password-7h2k9p@localhost:5432/example

# First account email and password. Use a password of at least 8 characters.
ADMIN_USERNAME=person@example.com
ADMIN_PASSWORD=example-account-password-3m6r

# Managed Better Auth.
NEON_AUTH_BASE_URL=https://auth.example.com/example/auth
NEON_AUTH_COOKIE_SECRET=example-cookie-secret-with-32-characters

# Object storage. The bucket name in this app is assets.
AWS_ACCESS_KEY_ID=EXAMPLEACCESSKEY000000
AWS_SECRET_ACCESS_KEY=example-storage-secret-5t1w
AWS_ENDPOINT_URL_S3=https://storage.example.com
AWS_REGION=auto
S3_PRESIGN_SECONDS=900
